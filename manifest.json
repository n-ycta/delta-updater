{
  "id": "updater",
  "version": "0.1.2",
  "description": "Headless updater service; no Web or graphical host required.",
  "metadata": {
    "ui": {
      "id": "dev.delta.updater",
      "name": "Delta Updater",
      "version": "0.1.2",
      "contract": "^1.5.0",
      "description": "Headless updater service; no Web or graphical host required.",
      "publisher": "Delta",
      "icon": "download",
      "category": "system",
      "runtime": {
        "targets": [
          "desktop",
          "vps",
          "container"
        ]
      },
      "capabilities": [
        "actions"
      ],
      "metrics": [],
      "repository": "https://github.com/n-ycta/delta-updater",
      "permissions": [
        {
          "scope": "admin",
          "reason": "Trusted executable service; OS sandboxing is not provided.",
          "optional": false
        }
      ],
      "dependencies": [
        {
          "kind": "core",
          "version": ">=0.4.3, <0.5.0",
          "required": true,
          "id": "core"
        }
      ]
    }
  },
  "capabilities": [
    {
      "name": "status",
      "params": {},
      "admin": true,
      "description": "Updater API: status"
    },
    {
      "name": "check",
      "params": {},
      "admin": true,
      "description": "Updater API: check"
    },
    {
      "name": "settings",
      "params": {},
      "admin": true,
      "description": "Updater API: settings"
    },
    {
      "name": "install",
      "params": {},
      "admin": true,
      "description": "Updater API: install"
    },
    {
      "name": "notes",
      "admin": true,
      "params": {}
    },
    {
      "name": "mark",
      "admin": true,
      "params": {}
    }
  ]
}
